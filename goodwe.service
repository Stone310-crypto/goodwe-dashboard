[Unit]
Description=GoodWe Monitor Kern-Service (Poller + API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/leon/goodwe-dashboard
ExecStart=/home/leon/goodwe-dashboard/.venv/bin/python main.py
# Bei Bedarf IP/Ports hier überschreiben, z. B.:
# Environment=GOODWE_IP=192.168.1.105
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
